    "typescript": "catalog:"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@types/pg": "^8.16.0",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3",
    "zod": "catalog:",
    "tsdown": "^0.16.5"
  }
