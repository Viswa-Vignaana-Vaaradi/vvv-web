{
  "name": "@repo/db",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "require": "./src/*.ts",
      "default": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mts"
      },
      "require": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown src/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@types/pg": "^8.16.0",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3",
    "zod": "catalog:",
    "tsdown": "^0.16.5"
  }
}
