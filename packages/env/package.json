{
  "name": "@repo/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./src/server.ts",
      "default": {
        "import": {
          "types": "./dist/web.d.ts",
          "default": "./dist/web.mjs"
        },
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs",
        "require": "./dist/server.js"
      }
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./src/web.ts",
      "require": "./src/web.ts",
      "default": {
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.mjs"
      },
      "require": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
      }
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown src/server.ts src/web.ts --outDir dist"
  },
  "dependencies": {
    "zod": "catalog:",
    "@t3-oss/env-nextjs": "^0.13.1",
    "@t3-oss/env-core": "^0.13.1",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "^22.13.11",
    "@repo/config": "workspace:*",
    "tsdown": "^0.16.5"
  }
}
