{
  "name": "@repo/auth",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown src/index.ts"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "typescript": "catalog:",
    "tsdown": "^0.16.5"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "resend": "^6.8.0",
    "zod": "catalog:"
  }
}
